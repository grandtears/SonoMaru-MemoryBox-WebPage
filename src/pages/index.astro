      '私立VRC学園 23-2',
    ],
    links: {
      x: 'https://x.com/vmarur_2525',
      vrchat: 'https://vrchat.com/home/user/usr_43cfaa49-8e65-462d-ad55-33e00aa9c12b',
    },
  },
  {
    name: 'Sonoty',
    icon: '/images/sonoty.PNG',
